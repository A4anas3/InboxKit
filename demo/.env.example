# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=9000

# ─── PostgreSQL Database Configuration ─────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_db_password
PGDATABASE=demo

# ─── Redis Configuration ───────────────────────────────────────────────────────
REDISHOST=localhost
REDISPORT=6379
REDISUSER=default
REDISPASSWORD=your_redis_password

# ─── Supabase JWT Secret Configuration ─────────────────────────────────────────
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
